{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neuron7",
  "version": "0.1.0",
  "identifier": "app.neuron7.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "neuron7",
        "width": 1480,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
